#!/bin/sh
# Enforces conventional commit messages.
# Enable once per clone: git config core.hooksPath .githooks

header=$(head -1 "$1")
if ! echo "$header" | grep -qE '^(Merge |Revert |fixup!|squash!)' &&
   ! echo "$header" | grep -qE '^(feat|fix|docs|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9./-]+\))?!?: .+'; then
    echo "commit-msg: header must be conventional: type(scope)?: summary" >&2
    echo "  types: feat fix docs refactor perf test build ci chore revert" >&2
    exit 1
fi
exit 0
